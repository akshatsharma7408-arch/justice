# JUSTICE Legal AI - environment template.
# Copy to .env (backend/.env or repo root .env.local) and fill real values.
# .env is gitignored; NEVER commit real keys.

# Primary LLM API key: Groq (https://console.groq.com)
# Enforced model: openai/gpt-oss-120b with automated spillover to 20b
GROQ_API_KEY=your_groq_api_key_here

# Fallback LLM API key: Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Optional site-wide HTTP Basic Auth password gate for production deployment
# (Leave blank for unrestricted local development)
SITE_PASSWORD=

# Qdrant vector database (docker compose service name resolves internally)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=indian_legal_precedents

# Neo4j knowledge graph (Article 141 citation DAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_neo4j_password

# Frontend: where the Vite app finds the backend
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000
